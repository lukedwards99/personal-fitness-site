{
  "name": "personal-fitness-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal training advice and a bodybuilding journal, built for Cloudflare Workers.",
  "engines": {
    "node": "24.15.x"
  },
  "scripts": {
    "dev": "npm run db:setup && vite",
    "dev:server": "vite",
    "dev:tailnet": "node scripts/tailnet-preview.mjs",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "tsx scripts/seed-local.ts",
    "db:seed:dev": "node --import tsx scripts/seed-remote.ts dev",
    "db:seed:main": "node --import tsx scripts/seed-remote.ts main",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:dev": "npm run typecheck && CLOUDFLARE_ENV=dev vite build",
    "build:main": "npm run typecheck && CLOUDFLARE_ENV=production vite build",
    "deploy:dev": "node scripts/deploy-lane.mjs dev",
    "deploy:main": "node scripts/deploy-lane.mjs main",
    "check": "npm run typecheck && npm run build",
    "check:api": "node scripts/check-api.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5178 --strictPort",
    "lane:names": "node scripts/lane-names.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "^5.3.0",
    "hono": "^4.13.3",
    "lucide-react": "^0.468.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/workers-types": "^5.20260822.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "^4.125.0"
  }
}
