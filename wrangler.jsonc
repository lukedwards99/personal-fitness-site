{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-fitness-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "local"
  },
  "env": {
    "dev": {
      "name": "personal-fitness-dev",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "dev"
      },
      "r2_buckets": [
        {
          "binding": "CONTENT",
          "bucket_name": "personal-fitness-content-dev"
        }
      ]
    },
    "production": {
      "name": "personal-fitness-production",
      "workers_dev": true,
      "vars": {
        "APP_ENV": "production"
      },
      "r2_buckets": [
        {
          "binding": "CONTENT",
          "bucket_name": "personal-fitness-content-production"
        }
      ]
    }
  },
  "account_id": "ddb45a91c623b716978d580d88298be1",
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "personal-fitness-content-local"
    }
  ]
}
